{
  "name": "@tx-meta/dcu-kit",
  "version": "0.5.6-preprod.0",
  "description": "Offchain SDK for DCU Toolkit — ROSCA protocol on Cardano",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./multisig": {
      "types": "./dist/multisig/index.d.ts",
      "import": "./dist/multisig/index.js",
      "require": "./dist/multisig/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./escrow": {
      "types": "./dist/escrow/index.d.ts",
      "import": "./dist/escrow/index.js",
      "require": "./dist/escrow/index.cjs"
    },
    "./escrow/v2": {
      "types": "./dist/escrow/v2/index.d.ts",
      "import": "./dist/escrow/v2/index.js",
      "require": "./dist/escrow/v2/index.cjs"
    },
    "./savings": {
      "types": "./dist/savings/index.d.ts",
      "import": "./dist/savings/index.js",
      "require": "./dist/savings/index.cjs"
    },
    "./governance": {
      "types": "./dist/governance/index.d.ts",
      "import": "./dist/governance/index.js",
      "require": "./dist/governance/index.cjs"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js",
      "require": "./dist/harness/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tx-meta/dcu-kit"
  },
  "license": "BUSL-1.1",
  "keywords": [
    "cardano",
    "rosca",
    "blockchain",
    "lucid-evolution",
    "effect",
    "aiken",
    "dcu",
    "coop",
    "chama",
    "sacco",
    "tontine"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup src/index.ts src/multisig/index.ts src/core/index.ts src/escrow/index.ts src/escrow/v2/index.ts src/savings/index.ts src/governance/index.ts src/harness/index.ts --minify --format esm,cjs --dts --clean",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "test": "NETWORK=Emulator vitest run",
    "repack": "pnpm run build && pnpm pack && mv -f tx-meta-dcu-kit-$(node -p 'require(\"./package.json\").version').tgz dcu-kit-$(node -p 'require(\"./package.json\").version').tgz",
    "examples:setup": "pnpm run repack && cd examples && pnpm add file:../dcu-kit-$(node -p 'require(\"../package.json\").version').tgz --force",
    "examples:create-account": "pnpm run examples:setup && cd examples && npx tsx create-account.ts",
    "examples:create-group": "pnpm run examples:setup && cd examples && npx tsx create-group.ts",
    "examples:join-group": "pnpm run examples:setup && cd examples && npx tsx join-group.ts",
    "examples:rosca-lifecycle": "pnpm run examples:setup && cd examples && npx tsx rosca-lifecycle.ts"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.62.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "libsodium-wrappers": "^0.8.4",
    "libsodium-wrappers-sumo": "0.8.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@lucid-evolution/lucid": "0.4.31",
    "@noble/hashes": "^1.8.0",
    "effect": "^3.21.4"
  }
}
